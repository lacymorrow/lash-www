#!/usr/bin/env bash
# Pre-commit secret scan (see LAC-3163).
# Runs `gitleaks protect --staged` on staged changes only.
# To bypass in a true emergency: git commit --no-verify (do not use for
# routine work — the whole point of this hook is to stop leaks pre-push).

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOM'
gitleaks not found on PATH.

Install it once, then retry the commit:
  macOS:   brew install gitleaks
  Linux:   see https://github.com/gitleaks/gitleaks#installing

There is NO CI backstop. .github/workflows/gitleaks.yml is gated off because
Actions billing is a permanent WONTFIX (LAC-4925), so this hook and
`bun run verify:pr` are the only secret scans between you and the remote.
Install it; do not skip past this.
EOM
  exit 1
fi

gitleaks protect --staged --no-banner --redact
