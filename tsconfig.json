{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "inlineSources": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@/.source/*": ["./.source/*"],
      "@/public/*": ["./public/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "eslint.config.mjs",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.mts",
    "**/*.md",
    "**/*.mdx",
    ".next/types/**/*.ts",
    "src/types/next-auth.d.ts",
    "next.config.ts",
    "src/workers/**/*",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    ".next",
    "node_modules",
    ".vercel",
    "tests",
    "public",
    "packages",
    "docs-site",
    "debug/**/*.ts",
    "scripts",
    "src/app/(app)/(demo)/examples/**/*",
    "src/workers/**/*.ts",
    // Never typecheck build output. `include` globs `**/*.js`, and `.gitignore`
    // ignores every `dist/`, so any build artifact left in the tree got
    // typechecked: a stray `cli/dist/index.js` produced 19 TS7006 errors here
    // with zero tracked files behind them. No `dist/` file is tracked in this
    // repo, so this excludes nothing real.
    "**/dist"
  ]
}
